<?xml version="1.0"?>
<!-- Expression semantics: Python int/float rules, repr of floats, operators, functions, strings. -->
<robot name="expressions" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="dummy" default="argval"/>
  <xacro:property name="i" value="7"/>
  <xacro:property name="f" value="2.5"/>
  <xacro:property name="s" value="abc"/>
  <xacro:property name="q" value="'quoted value'"/>
  <xacro:property name="under" value="1_000"/>
  <xacro:property name="t" value="true"/>
  <xacro:property name="small" value="0.00001234"/>
  <xacro:property name="big" value="1e20"/>
  <link name="l">
    <e a="${i / 2}" b="${i // 2}" c="${-i // 2}" d="${i % 3}" e="${-i % 3}" f="${i ** 2}" g="${2 ** -1}" h="${-2 ** 2}"/>
    <e a="${f * 2}" b="${f + i}" c="${i * 1.0}" d="${0.1 + 0.2}" e="${1 / 3}" f="${small}" g="${big}" h="${small * 10}"/>
    <e a="${1 &lt; i &lt;= 7}" b="${i == 7.0}" c="${i != 7 or 'x'}" d="${0 and 5}" e="${'' or 'fallback'}" f="${not t}" g="${1 if t else 2}" h="${s in 'xabcx'}"/>
    <e a="${s + '_' + str(i)}" b="${s * 2}" c="${len(s)}" d="${s[1]}" e="${s[-1]}" f="${q}" g="${under}" h="${'%s-%d' % (s, i)}"/>
    <e a="${sqrt(16)}" b="${floor(2.7)}" c="${ceil(2.1)}" d="${python.abs(-3)}" e="${python.abs(-3.5)}" f="${min(3, 1.5, 2)}" g="${max([4, 9, 2])}" h="${round(2.5)}"/>
    <e a="${round(3.14159, 2)}" b="${int(3.9)}" c="${float(2)}" d="${int('42')}" e="${atan2(1, 1)}" f="${pow(2, 10)}" g="${math.pi}" h="${radians(180)}"/>
    <e a="${degrees(pi)}" b="${sin(0)}" c="${cos(0)}" d="${tan(0)}" e="${exp(0)}" f="${log(1)}" g="${math.log(8, 2)}" h="${fabs(-0.0)}"/>
    <e a="${True}" b="${None}" c="${bool(0)}" d="${list(range(3))}" e="${python.sum([1, 2, 3.5])}" f="${sorted([3, 1, 2])}" g="${python.len('abcd')}" h="${xacro.arg('dummy')}"/>
    <e a="text ${i} and ${f}" b="$${i}" c="$$(arg x)" d="${i}${i}" e="cost: $5" f="${s.upper() if False else s}" g="${hypot(3, 4)}" h="${copysign(1, -0.0)}"/>
  </link>
</robot>
