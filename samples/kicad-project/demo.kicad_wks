(kicad_wks (version 20231118) (generator "pl_editor") (generator_version "8.0")
  (setup (textsize 1.5 1.5) (linewidth 0.15) (textlinewidth 0.15) (left_margin 10) (right_margin 10) (top_margin 10) (bottom_margin 10))
  (rect (name "") (start 0 0 ltcorner) (end 0 0) (comment "outer frame"))
  (rect (name "") (start 4 4 ltcorner) (end 4 4) (linewidth 0.3) (comment "inner frame"))
  (line (name "") (start 70 0 ltcorner) (end 70 4 ltcorner) (repeat 8) (incrx 70))
  (tbtext "1" (name "") (pos 35 2 ltcorner) (font (size 1.3 1.3)) (justify center) (repeat 8) (incrx 70))
  (tbtext "A" (name "") (pos 2 30 ltcorner) (font (size 1.3 1.3)) (justify center) (repeat 8) (incry 60))
  (rect (name "") (start 140 40) (end 4 4) (linewidth 0.3) (comment "title block"))
  (line (name "") (start 140 16) (end 4 16))
  (line (name "") (start 140 28) (end 4 28))
  (tbtext "CUSTOM SHEET · ${PROJECT_CODE}" (name "") (pos 138 34) (font (size 2.5 2.5) bold))
  (tbtext "${TITLE}" (name "") (pos 138 22) (font (size 2 2)))
  (tbtext "Sheet ${#} of ${##} · ${SHEETPATH}" (name "") (pos 138 10))
  (tbtext "Rev ${REVISION} · ${ISSUE_DATE}" (name "") (pos 50 10))
  (tbtext "First page only" (name "") (pos 138 44) (option page1only))
)
