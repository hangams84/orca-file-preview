<?xml version="1.0"?>
<!-- A differential-drive mobile base: two continuous wheels, a passive caster (swivel + wheel),
     a lidar on a lifting mast and a capsule bumper (ROS 2 URDF capsule extension). Written for
     File Preview's samples (MIT). -->
<robot name="diff_drive_base">
  <material name="body"><color rgba="0.16 0.42 0.78 1"/></material>
  <material name="rubber"><color rgba="0.1 0.1 0.1 1"/></material>
  <material name="metal"><color rgba="0.7 0.7 0.72 1"/></material>

  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.08"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.06"/>
      <geometry><box size="0.5 0.36 0.12"/></geometry>
      <material name="body"/>
    </visual>
    <visual name="top_plate">
      <origin xyz="-0.02 0 0.13"/>
      <geometry><box size="0.42 0.32 0.02"/></geometry>
      <material name="metal"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.07"/>
      <geometry><box size="0.5 0.36 0.14"/></geometry>
    </collision>
    <inertial><mass value="12"/><inertia ixx="0.2" ixy="0" ixz="0" iyy="0.3" iyz="0" izz="0.4"/></inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0.08 0.21 0" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="20" velocity="12"/>
  </joint>
  <link name="left_wheel">
    <visual>
      <geometry><cylinder radius="0.08" length="0.05"/></geometry>
      <material name="rubber"/>
    </visual>
    <visual>
      <origin xyz="0.04 0 0.026"/>
      <geometry><box size="0.06 0.012 0.004"/></geometry>
      <material name="metal"/>
    </visual>
    <collision><geometry><cylinder radius="0.08" length="0.05"/></geometry></collision>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0.08 -0.21 0" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="right_wheel">
    <visual>
      <geometry><cylinder radius="0.08" length="0.05"/></geometry>
      <material name="rubber"/>
    </visual>
    <visual>
      <origin xyz="0.04 0 -0.026"/>
      <geometry><box size="0.06 0.012 0.004"/></geometry>
      <material name="metal"/>
    </visual>
    <collision><geometry><cylinder radius="0.08" length="0.05"/></geometry></collision>
  </link>

  <joint name="caster_swivel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="caster_fork"/>
    <origin xyz="-0.19 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="caster_fork">
    <visual>
      <origin xyz="-0.015 0 -0.02"/>
      <geometry><box size="0.05 0.04 0.04"/></geometry>
      <material name="metal"/>
    </visual>
  </link>
  <joint name="caster_wheel_joint" type="continuous">
    <parent link="caster_fork"/>
    <child link="caster_wheel"/>
    <origin xyz="-0.03 0 -0.05" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="caster_wheel">
    <visual>
      <geometry><sphere radius="0.03"/></geometry>
      <material name="rubber"/>
    </visual>
    <collision><geometry><sphere radius="0.03"/></geometry></collision>
  </link>

  <joint name="bumper_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_bumper"/>
    <origin xyz="0.27 0 0.04" rpy="1.5708 0 0"/>
  </joint>
  <link name="front_bumper">
    <visual>
      <geometry><capsule radius="0.025" length="0.3"/></geometry>
      <material name="rubber"/>
    </visual>
    <collision><geometry><capsule radius="0.025" length="0.3"/></geometry></collision>
  </link>

  <joint name="mast_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="mast"/>
    <origin xyz="0.12 0 0.14"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="0.2" effort="50" velocity="0.1"/>
  </joint>
  <link name="mast">
    <visual>
      <origin xyz="0 0 0.08"/>
      <geometry><box size="0.04 0.04 0.16"/></geometry>
      <material name="metal"/>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="mast"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.185"/>
  </joint>
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.04" length="0.05"/></geometry>
      <material><color rgba="0.15 0.15 0.15 1"/></material>
    </visual>
    <visual>
      <origin xyz="0 0 0.03"/>
      <geometry><cylinder radius="0.035" length="0.01"/></geometry>
      <material><color rgba="0.9 0.2 0.2 1"/></material>
    </visual>
  </link>

  <gazebo reference="left_wheel"><mu1>1.0</mu1></gazebo>
  <ros2_control name="base" type="system"><hardware><plugin>mock_components/GenericSystem</plugin></hardware></ros2_control>
</robot>
