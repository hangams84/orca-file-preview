   },
   "lines": [
    {
     "text": "가. 교육과정 성취기준 및 평가 기준",
     "x": 56.69,
     "y": 103.12,
     "base": 112.47,
     "size": 11.0,
     "lineHeight": 11.0,
     "width": 481.88
    },
