<?xml version="1.0"?>
<!-- A xacro macro library: it defines macros and properties but no links, like the files robot
     descriptions include. The preview lists what it defines. Written for File Preview's samples (MIT). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="default_mass" value="0.5"/>

  <xacro:macro name="box_link" params="name size:='0.1 0.1 0.1' mass:=${default_mass} *origin">
    <link name="${name}">
      <visual><xacro:insert_block name="origin"/><geometry><box size="${size}"/></geometry></visual>
      <inertial><mass value="${mass}"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
    </link>
  </xacro:macro>

  <xacro:macro name="fixed_joint" params="parent child xyz:='0 0 0' rpy:='0 0 0'">
    <joint name="${parent}_to_${child}" type="fixed">
      <parent link="${parent}"/>
      <child link="${child}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="sensor_mount" params="prefix parent **sensors">
    <xacro:box_link name="${prefix}_mount"><origin xyz="0 0 0.01"/></xacro:box_link>
    <xacro:fixed_joint parent="${parent}" child="${prefix}_mount"/>
  </xacro:macro>
</robot>
