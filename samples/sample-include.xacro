<?xml version="1.0"?>
<!-- A xacro file that includes other files. The preview only receives this file, so the includes
     are listed as not loaded, and the macros and properties they would define show up as notes.
     Everything defined here is still drawn. Written for File Preview's samples (MIT). -->
<robot name="sensor_tower" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find tower_description)/urdf/common_materials.xacro"/>
  <xacro:include filename="sensors/lidar.urdf.xacro"/>
  <xacro:include filename="optional_extras.xacro" optional="true"/>

  <xacro:property name="pole_height" value="1.2"/>
  <xacro:property name="pole_radius" value="${pole_height / 40}"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.02"/>
      <geometry><box size="0.4 0.4 0.04"/></geometry>
      <material name="concrete"><color rgba="0.6 0.6 0.58 1"/></material>
    </visual>
  </link>
  <link name="pole">
    <visual>
      <origin xyz="0 0 ${pole_height / 2}"/>
      <geometry><cylinder radius="${pole_radius}" length="${pole_height}"/></geometry>
      <!-- "steel" would come from common_materials.xacro -->
      <material name="steel"/>
    </visual>
  </link>
  <joint name="pole_joint" type="fixed">
    <parent link="base_link"/>
    <child link="pole"/>
    <origin xyz="0 0 0.04"/>
  </joint>

  <!-- macros defined in the included files: not available here -->
  <xacro:lidar_3d name="top_lidar" parent="pole">
    <origin xyz="0 0 ${pole_height + 0.05}"/>
  </xacro:lidar_3d>
  <xacro:camera_box name="front_camera" parent="pole" size="${camera_size}"/>

  <link name="sign">
    <visual>
      <origin xyz="0.05 0 0"/>
      <geometry><box size="0.01 0.3 0.2"/></geometry>
      <material name="sign_red"><color rgba="0.85 0.1 0.1 1"/></material>
    </visual>
  </link>
  <joint name="sign_joint" type="fixed">
    <parent link="pole"/>
    <child link="sign"/>
    <!-- sign_height would come from an included file: the origin keeps its default -->
    <origin xyz="${pole_radius} 0 ${sign_height}"/>
  </joint>
</robot>
