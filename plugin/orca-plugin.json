{
  "manifestVersion": 2,
  "id": "file-preview",
  "name": "File Preview",
  "version": "0.4.0",
  "description": "Read-only previews for Word (doc, docx), Hangul (hwp, hwpx), PowerPoint (ppt, pptx), Excel (xls, xlsx, xlsm, ods), PDF, text, CSV/TSV, HTML, SVG, GIF/BMP, 3D models and CAD (STL, OBJ, PLY, glTF, 3MF, OFF, FBX, DAE, STEP, IGES, BREP), 2D CAD drawings (DXF, DWF, DWFx), diagrams (draw.io, Visio), KiCad (schematic, board, footprint, symbol, project), SolidWorks (previews, properties, part meshes), EPLAN (part data, project archives) ROS robot descriptions (URDF, xacro) and AI models (PyTorch, safetensors, ONNX, TFLite, GGUF, Keras, NumPy) inside Orca, on desktop and mobile.",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "sandboxed-ui",
  "pluginApi": 1,
  "contributes": {
    "customEditors": [
      {
        "id": "office",
        "title": "Office · PDF Preview",
        "extensions": [
          ".docx",
          ".doc",
          ".pptx",
          ".ppt",
          ".xlsx",
          ".xlsm",
          ".xls",
          ".ods",
          ".hwp",
          ".hwpx",
          ".pdf"
        ],
        "entry": "editor/main.ts",
        "contentKind": "bytes",
        "frame": "any"
      },
      {
        "id": "media",
        "title": "Text · Web · Image Preview",
        "extensions": [
          ".txt",
          ".log",
          ".csv",
          ".tsv",
          ".html",
          ".htm",
          ".xhtml",
          ".svg",
          ".gif",
          ".bmp"
        ],
        "entry": "editor/main.ts",
        "contentKind": "bytes",
        "frame": "any"
      },
      {
        "id": "diagram",
        "title": "Diagram Preview",
        "extensions": [
          ".drawio",
          ".dio",
          ".vsdx",
          ".vsdm",
          ".vstx",
          ".vssx"
        ],
        "entry": "editor/main.ts",
        "contentKind": "bytes",
        "frame": "any"
      },
      {
        "id": "model3d",
        "title": "3D · Robot Preview",
        "extensions": [
          ".stl",
          ".obj",
          ".ply",
          ".glb",
          ".gltf",
          ".3mf",
          ".off",
          ".fbx",
          ".dae",
          ".step",
          ".stp",
          ".stpz",
          ".iges",
          ".igs",
          ".brep",
          ".urdf",
          ".xacro"
        ],
        "entry": "editor/main.ts",
        "contentKind": "bytes",
        "frame": "any"
      },
      {
        "id": "engineering",
        "title": "CAD · Engineering Preview",
        "extensions": [
          ".dxf",
          ".dwf",
          ".dwfx",
          ".kicad_sch",
          ".kicad_pcb",
          ".kicad_mod",
          ".kicad_sym",
          ".kicad_pro",
          ".kicad_wks",
          ".sldprt",
          ".sldasm",
          ".slddrw",
          ".slddrt",
          ".prtdot",
          ".asmdot",
          ".drwdot",
          ".elk",
          ".ell",
          ".elr",
          ".els",
          ".elp",
          ".elx",
          ".ela",
          ".zw1",
          ".zx1",
          ".edz",
          ".ema",
          ".emp"
        ],
        "entry": "editor/main.ts",
        "contentKind": "bytes",
        "frame": "any"
      },
      {
        "id": "aimodel",
        "title": "AI Model Preview",
        "extensions": [
          ".pt",
          ".pth",
          ".ckpt",
          ".chkpt",
          ".pt2",
          ".ptl",
          ".safetensors",
          ".onnx",
          ".tflite",
          ".gguf",
          ".keras",
          ".h5",
          ".hdf5",
          ".npy",
          ".npz"
        ],
        "entry": "editor/main.ts",
        "contentKind": "bytes",
        "frame": "any"
      },
      {
        "id": "text-text",
        "title": "Text Preview",
        "extensions": [
          ".txt",
          ".log"
        ],
        "entry": "editor/text/text.ts",
        "contentKind": "text",
        "frame": "any"
      },
      {
        "id": "csv-text",
        "title": "Table Preview",
        "extensions": [
          ".csv",
          ".tsv"
        ],
        "entry": "editor/text/csv.ts",
        "contentKind": "text",
        "frame": "any"
      },
      {
        "id": "web-text",
        "title": "HTML Preview",
        "extensions": [
          ".html",
          ".htm",
          ".xhtml"
        ],
        "entry": "editor/text/web.ts",
        "contentKind": "text",
        "frame": "any"
      },
      {
        "id": "diagram-text",
        "title": "Diagram Preview",
        "extensions": [
          ".drawio",
          ".dio"
        ],
        "entry": "editor/text/diagram.ts",
        "contentKind": "text",
        "frame": "any"
      },
      {
        "id": "model3d-text",
        "title": "3D Preview",
        "extensions": [
          ".stl",
          ".obj",
          ".ply",
          ".gltf",
          ".off",
          ".fbx",
          ".dae",
          ".step",
          ".stp",
          ".iges",
          ".igs",
          ".brep"
        ],
        "entry": "editor/text/model3d.ts",
        "contentKind": "text",
        "frame": "any"
      },
      {
        "id": "kicad-text",
        "title": "KiCad Preview",
        "extensions": [
          ".kicad_sch",
          ".kicad_pcb",
          ".kicad_mod",
          ".kicad_sym",
          ".kicad_pro",
          ".kicad_wks"
        ],
        "entry": "editor/text/kicad.ts",
        "contentKind": "text",
        "frame": "any"
      },
      {
        "id": "dxf-text",
        "title": "CAD Drawing Preview",
        "extensions": [
          ".dxf"
        ],
        "entry": "editor/text/dxf.ts",
        "contentKind": "text",
        "frame": "any"
      },
      {
        "id": "robot-text",
        "title": "Robot Preview",
        "extensions": [
          ".urdf",
          ".xacro"
        ],
        "entry": "editor/text/robot.ts",
        "contentKind": "text",
        "frame": "any"
      },
      {
        "id": "office-text",
        "title": "Office Preview",
        "extensions": [
          ".doc",
          ".xls"
        ],
        "entry": "editor/text/office.ts",
        "contentKind": "text",
        "frame": "any"
      },
      {
        "id": "eplan-text",
        "title": "EPLAN Macro Preview",
        "extensions": [
          ".ema",
          ".emp"
        ],
        "entry": "editor/text/eplan.ts",
        "contentKind": "text",
        "frame": "any"
      }
    ],
    "panels": [
      {
        "id": "preview",
        "title": "File Preview",
        "icon": "file",
        "entry": "panel/main.ts"
      }
    ]
  },
  "license": "MIT"
}
