{
  "manifestVersion": 2,
  "id": "file-preview",
  "name": "File Preview",
  "version": "0.3.0",
  "description": "Read-only previews for Word (doc, docx), Hangul (hwp, hwpx), PowerPoint (ppt, pptx), Excel (xls, xlsx, xlsm, ods), PDF, text, CSV/TSV, HTML, SVG, GIF/BMP, 3D models and CAD (STL, OBJ, PLY, glTF, 3MF, OFF, FBX, DAE, STEP, IGES, BREP), 2D CAD drawings (DXF, DWF, DWFx), diagrams (draw.io, Visio), KiCad (schematic, board, footprint, symbol, project), SolidWorks (previews, properties, part meshes) and EPLAN (part data, project archives) inside Orca, on desktop and mobile.",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "sandboxed-ui",
  "pluginApi": 1,
  "contributes": {
    "customEditors": [
      {
        "id": "word",
        "title": "Word Preview",
        "extensions": [
          ".docx",
          ".doc"
        ],
        "entry": "editor/main.ts",
        "contentKind": "bytes",
        "frame": "any"
      },
      {
        "id": "slides",
        "title": "Slides Preview",
        "extensions": [
          ".pptx",
          ".ppt"
        ],
        "entry": "editor/main.ts",
        "contentKind": "bytes",
        "frame": "any"
      },
      {
        "id": "sheet",
        "title": "Sheet Preview",
        "extensions": [
          ".xlsx",
          ".xlsm",
          ".xls",
          ".ods"
        ],
        "entry": "editor/main.ts",
        "contentKind": "bytes",
        "frame": "any"
      },
      {
        "id": "pdf",
        "title": "PDF Preview",
        "extensions": [
          ".pdf"
        ],
        "entry": "editor/main.ts",
        "contentKind": "bytes",
        "frame": "any"
      },
      {
        "id": "image",
        "title": "Image Preview",
        "extensions": [
          ".gif",
          ".bmp",
          ".svg"
        ],
        "entry": "editor/main.ts",
        "contentKind": "bytes",
        "frame": "any"
      },
      {
        "id": "web",
        "title": "HTML Preview",
        "extensions": [
          ".html",
          ".htm",
          ".xhtml"
        ],
        "entry": "editor/main.ts",
        "contentKind": "bytes",
        "frame": "any"
      },
      {
        "id": "csv",
        "title": "Table Preview",
        "extensions": [
          ".csv",
          ".tsv"
        ],
        "entry": "editor/main.ts",
        "contentKind": "bytes",
        "frame": "any"
      },
      {
        "id": "hangul",
        "title": "Hangul Preview",
        "extensions": [
          ".hwp",
          ".hwpx"
        ],
        "entry": "editor/main.ts",
        "contentKind": "bytes",
        "frame": "any"
      },
      {
        "id": "text",
        "title": "Text Preview",
        "extensions": [
          ".txt",
          ".log"
        ],
        "entry": "editor/main.ts",
        "contentKind": "bytes",
        "frame": "any"
      },
      {
        "id": "diagram",
        "title": "Diagram Preview",
        "extensions": [
          ".drawio",
          ".dio",
          ".vsdx",
          ".vsdm",
          ".vstx",
          ".vssx"
        ],
        "entry": "editor/main.ts",
        "contentKind": "bytes",
        "frame": "any"
      },
      {
        "id": "model3d",
        "title": "3D Preview",
        "extensions": [
          ".stl",
          ".obj",
          ".ply",
          ".glb",
          ".gltf",
          ".3mf",
          ".off",
          ".fbx",
          ".dae",
          ".step",
          ".stp",
          ".stpz",
          ".iges",
          ".igs",
          ".brep"
        ],
        "entry": "editor/main.ts",
        "contentKind": "bytes",
        "frame": "any"
      },
      {
        "id": "solidworks",
        "title": "SolidWorks Preview",
        "extensions": [
          ".sldprt",
          ".sldasm",
          ".slddrw",
          ".slddrt",
          ".prtdot",
          ".asmdot",
          ".drwdot"
        ],
        "entry": "editor/main.ts",
        "contentKind": "bytes",
        "frame": "any"
      },
      {
        "id": "eplan",
        "title": "EPLAN Preview",
        "extensions": [
          ".elk",
          ".ell",
          ".elr",
          ".els",
          ".elp",
          ".elx",
          ".ela",
          ".zw1",
          ".zx1",
          ".edz"
        ],
        "entry": "editor/main.ts",
        "contentKind": "bytes",
        "frame": "any"
      },
      {
        "id": "kicad",
        "title": "KiCad Preview",
        "extensions": [
          ".kicad_sch",
          ".kicad_pcb",
          ".kicad_mod",
          ".kicad_sym",
          ".kicad_pro"
        ],
        "entry": "editor/main.ts",
        "contentKind": "bytes",
        "frame": "any"
      },
      {
        "id": "cad2d",
        "title": "CAD Drawing Preview",
        "extensions": [
          ".dxf",
          ".dwf",
          ".dwfx"
        ],
        "entry": "editor/main.ts",
        "contentKind": "bytes",
        "frame": "any"
      }
    ]
  },
  "license": "MIT"
}
