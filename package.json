{
  "name": "orca-file-preview",
  "private": true,
  "version": "0.1.0",
  "description": "Orca plugin: read-only previews for Office, PDF, text, CSV, HTML, SVG, GIF and BMP files.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "vendor": "node tools/build-vendor.mjs",
    "samples": "python tools/make-samples.py",
    "typecheck": "tsc -p plugin",
    "test": "orca plugin test plugin --json",
    "check": "orca plugin check plugin --json",
    "harness": "node tools/harness/run.mjs",
    "verify": "node tools/verify.mjs",
    "docs": "node tools/build-docs.mjs",
    "dev": "orca plugin dev watch plugin"
  },
  "devDependencies": {
    "cfb": "^1.2.2",
    "docx-preview": "^0.4.1",
    "dompurify": "^3.4.17",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "jszip": "^3.10.2",
    "pdfjs-dist": "^6.5.438",
    "playwright-core": "^1.65.0",
    "typescript": "^7.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}